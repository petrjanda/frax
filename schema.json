{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/petrjanda/frax/synq/dsl/directive",
  "properties": {
    "entities": {
      "properties": {
        "query": {
          "anyOf": [
            {
              "required": [
                "materialization"
              ],
              "title": "materialization"
            },
            {
              "required": [
                "entity_type"
              ],
              "title": "entity_type"
            },
            {
              "required": [
                "name"
              ],
              "title": "name"
            },
            {
              "required": [
                "schema"
              ],
              "title": "schema"
            },
            {
              "required": [
                "is_source"
              ],
              "title": "is_source"
            },
            {
              "required": [
                "is_join"
              ],
              "title": "is_join"
            },
            {
              "required": [
                "is_union"
              ],
              "title": "is_union"
            },
            {
              "required": [
                "data_product_impact"
              ],
              "title": "data_product_impact"
            },
            {
              "required": [
                "annotation"
              ],
              "title": "annotation"
            }
          ],
          "properties": {
            "materialization": {
              "type": "string",
              "description": "By how its materialized in the database (table, view, materialized_view)"
            },
            "entity_type": {
              "type": "string",
              "description": "By its type (dbt_model, dbt_source, table, view, airflow_task, tableau_dashboard, etc.)"
            },
            "name": {
              "type": "string",
              "description": "By its name, typically table name."
            },
            "schema": {
              "type": "string",
              "description": "By its schema"
            },
            "is_source": {
              "type": "boolean",
              "description": "Matches entities that are data sources"
            },
            "is_join": {
              "type": "boolean",
              "description": "Matches entities that JOIN the data."
            },
            "is_union": {
              "type": "boolean",
              "description": "Matches entities that are UNION the data."
            },
            "data_product_impact": {
              "oneOf": [
                {
                  "required": [
                    "importance"
                  ],
                  "title": "importance"
                },
                {
                  "required": [
                    "llm"
                  ],
                  "title": "llm"
                }
              ],
              "properties": {
                "importance": {
                  "items": {
                    "type": "string",
                    "enum": [
                      "P1",
                      "P2",
                      "P3"
                    ]
                  },
                  "type": "array"
                },
                "llm": {
                  "type": "string"
                }
              },
              "type": "object",
              "description": "We are matching all entities upstream of data products."
            },
            "annotation": {
              "properties": {
                "key": {
                  "type": "string"
                },
                "value": {
                  "type": "string"
                }
              },
              "type": "object",
              "required": [
                "key",
                "value"
              ],
              "description": "Matches entity that has specific key/value annotation. Tags, meta fields and other attributes are expressed as annotations."
            },
            "expand_upstream": {
              "type": "boolean",
              "description": "It will match all our operands and then expand selection to all nodes upstream via lineage."
            },
            "expand_downstream": {
              "type": "boolean",
              "description": "It will match all our operands and then expand selection to all nodes downstream via lineage."
            }
          },
          "type": "object",
          "description": "Structured query selector. Operands are ANDed together.\nQuery *Operand `json:\"query,omitempty\" jsonschema:\"oneof_required=query\"`"
        },
        "llm": {
          "type": "string",
          "description": "Prompt should only contain instructions to select entities. It should not specify what tests to deploy or columns to test.\nLLM string `json:\"llm,omitempty\" jsonschema:\"oneof_required=llm\"`"
        }
      },
      "type": "object",
      "description": "Defines which entities (typically tables) should be tested. Use either query or llm, not both."
    },
    "tests": {
      "anyOf": [
        {
          "required": [
            "unique"
          ],
          "title": "unique"
        },
        {
          "required": [
            "not_null"
          ],
          "title": "not_null"
        },
        {
          "required": [
            "pattern"
          ],
          "title": "pattern"
        },
        {
          "required": [
            "length"
          ],
          "title": "length"
        },
        {
          "required": [
            "range"
          ],
          "title": "range"
        },
        {
          "required": [
            "accepted_values"
          ],
          "title": "accepted_values"
        },
        {
          "required": [
            "table_stats_monitor"
          ],
          "title": "table_stats_monitor"
        },
        {
          "required": [
            "drift_monitor"
          ],
          "title": "drift_monitor"
        },
        {
          "required": [
            "llm"
          ],
          "title": "llm"
        }
      ],
      "properties": {
        "unique": {
          "properties": {
            "columns": {
              "oneOf": [
                {
                  "required": [
                    "names"
                  ],
                  "title": "names"
                },
                {
                  "required": [
                    "types"
                  ],
                  "title": "types"
                },
                {
                  "required": [
                    "llm"
                  ],
                  "title": "llm"
                }
              ],
              "properties": {
                "names": {
                  "items": {
                    "type": "string"
                  },
                  "type": "array",
                  "description": "Use to specify exact column names."
                },
                "types": {
                  "items": {
                    "type": "string"
                  },
                  "type": "array",
                  "description": "Use to select all columns of a certain types."
                },
                "llm": {
                  "type": "string",
                  "description": "Use to express ambiguous criteria that can't be expressed with other operations. Prompt should only contain instructions to select columns."
                }
              },
              "type": "object"
            }
          },
          "type": "object",
          "required": [
            "columns"
          ]
        },
        "not_null": {
          "properties": {
            "columns": {
              "oneOf": [
                {
                  "required": [
                    "names"
                  ],
                  "title": "names"
                },
                {
                  "required": [
                    "types"
                  ],
                  "title": "types"
                },
                {
                  "required": [
                    "llm"
                  ],
                  "title": "llm"
                }
              ],
              "properties": {
                "names": {
                  "items": {
                    "type": "string"
                  },
                  "type": "array",
                  "description": "Use to specify exact column names."
                },
                "types": {
                  "items": {
                    "type": "string"
                  },
                  "type": "array",
                  "description": "Use to select all columns of a certain types."
                },
                "llm": {
                  "type": "string",
                  "description": "Use to express ambiguous criteria that can't be expressed with other operations. Prompt should only contain instructions to select columns."
                }
              },
              "type": "object"
            }
          },
          "type": "object",
          "required": [
            "columns"
          ]
        },
        "pattern": {
          "properties": {
            "column": {
              "type": "string"
            },
            "pattern": {
              "type": "string"
            }
          },
          "type": "object",
          "required": [
            "column",
            "pattern"
          ]
        },
        "length": {
          "properties": {
            "column": {
              "type": "string"
            },
            "length": {
              "type": "integer"
            }
          },
          "type": "object",
          "required": [
            "column",
            "length"
          ]
        },
        "range": {
          "properties": {
            "column": {
              "type": "string"
            },
            "min": {
              "type": "integer"
            },
            "max": {
              "type": "integer"
            }
          },
          "type": "object",
          "required": [
            "column"
          ]
        },
        "accepted_values": {
          "properties": {
            "column": {
              "type": "string"
            },
            "values": {
              "items": {
                "type": "string"
              },
              "type": "array"
            }
          },
          "type": "object",
          "required": [
            "column",
            "values"
          ]
        },
        "table_stats_monitor": {
          "properties": {
            "volume": {
              "type": "boolean"
            },
            "freshness": {
              "type": "boolean"
            },
            "change_delay": {
              "type": "boolean"
            }
          },
          "type": "object",
          "description": "Monitor table for key metrics such as volume of rows, freshness of data, and delay between changes to number of rows. Doesn't need column selection."
        },
        "drift_monitor": {
          "properties": {
            "columns": {
              "oneOf": [
                {
                  "required": [
                    "names"
                  ],
                  "title": "names"
                },
                {
                  "required": [
                    "types"
                  ],
                  "title": "types"
                },
                {
                  "required": [
                    "llm"
                  ],
                  "title": "llm"
                }
              ],
              "properties": {
                "names": {
                  "items": {
                    "type": "string"
                  },
                  "type": "array",
                  "description": "Use to specify exact column names."
                },
                "types": {
                  "items": {
                    "type": "string"
                  },
                  "type": "array",
                  "description": "Use to select all columns of a certain types."
                },
                "llm": {
                  "type": "string",
                  "description": "Use to express ambiguous criteria that can't be expressed with other operations. Prompt should only contain instructions to select columns."
                }
              },
              "type": "object"
            }
          },
          "type": "object",
          "required": [
            "columns"
          ]
        },
        "llm": {
          "type": "string",
          "description": "Use to express ambiguous criteria that can't be expressed with other operations."
        }
      },
      "type": "object"
    }
  },
  "type": "object",
  "required": [
    "entities",
    "tests"
  ],
  "description": "Directive describes how tests should deploy"
}